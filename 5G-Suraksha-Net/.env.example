# ---- 5G Suraksha-Net : Crowd + Fight module environment ----
# Copy to .env and edit. Never commit .env.

# Sparsh CCTV / RTSP stream source.
# Examples:
#   rtsp://user:pass@10.0.0.5:554/Streaming/Channels/101
#   a local file path for testing: D:/videos/test.mp4
SURAKSHA_RTSP_URL=rtsp://localhost:554/stream1

# Inference device: auto | cuda | cpu   (auto = use GPU if available)
SURAKSHA_DEVICE=auto

# YOLO11s weights path (downloaded by scripts/download_weights.py on first run)
SURAKSHA_YOLO_WEIGHTS=models/yolo11s.pt

# Trained temporal fight classifier weights (empty = heuristic fallback until trained)
SURAKSHA_FIGHT_MODEL_PATH=

# REST/WebSocket server
SURAKSHA_API_HOST=0.0.0.0
SURAKSHA_API_PORT=8100

# Log level: DEBUG | INFO | WARNING | ERROR
SURAKSHA_LOG_LEVEL=INFO

# Where incident evidence is written
SURAKSHA_OUTPUT_DIR=outputs

# Google Maps API & Location Configuration (Phase 3)
# Keep GOOGLE_MAPS_API_KEY empty in version control; set in local .env when ready.
GOOGLE_MAPS_API_KEY=
DEMO_LOCATION_QUERY=Central Surveillance Zone

# Email Alert & Incident Evidence Delivery Configuration (Phase 3D)
# Set EMAIL_ENABLED=true and provide SMTP credentials in local .env to enable alerts.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
EMAIL_USE_TLS=true
EMAIL_MAX_ATTACHMENT_MB=25
